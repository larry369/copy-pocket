{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "copy-pocket",
  "version": "0.1.0",
  "identifier": "com.larry.copy-pocket",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "appDirectoriesOverride": "./app-data",
    "windows": [
      {
        "title": "copy-pocket",
        "width": 460,
        "height": 754,
        "minWidth": 460,
        "minHeight": 480,
        "resizable": true,
        "alwaysOnTop": true,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
